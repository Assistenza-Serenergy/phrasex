{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phrase X",
  "version": "0.2.0",
  "identifier": "org.phrasex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phrase X",
        "width": 1120,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "popup",
        "title": "Phrase X",
        "width": 460,
        "height": 440,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      },
      {
        "label": "form",
        "title": "Phrase X",
        "width": 480,
        "height": 460,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "installer/installer.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4OEEwN0ZCODQ2RDE5QTQKUldTa0dXMkUrd2VLYUJKdzhCQnBqdWFvSTI4ODkrMEtUWTUvaTdUNUNWVFJWU3N3RWZXOFg0R1cK",
      "endpoints": [
        "https://github.com/Assistenza-Serenergy/phrasex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
